# =================================================================================
# ZENITH-TIER APACHE REWRITE RULE DECK (.htaccess)
# =================================================================================
# Manages clean URLs, hides server file extensions, and preserves query parameters.
# Supports path-info routes (e.g. /b2_gateway/{id}/{file}).
# =================================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Prevent loop on rewritten files
    RewriteCond %{ENV:REDIRECT_STATUS} ^$

    # 2. Redirect external requests from .php to extensionless (SEO canonicalization)
    # Handles both standard scripts and scripts with path-info
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php([^?\ ]*)
    RewriteRule ^([^.]+)\.php(.*)$ /$1$2 [R=301,L]

    # 3. Internally map extensionless requests to physical PHP files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    # Map whitelisted routes to their physical PHP files
    RewriteRule ^(index|settings|upload|ads|login|logout|api|stream|b2_gateway)(/.*)?$ $1.php$2 [L,QSA]
</IfModule>
